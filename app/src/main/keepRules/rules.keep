# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# sherpa-onnx: the native side reads config fields and builds result objects through JNI by name.
-keep class com.k2fsa.sherpa.onnx.** { *; }

# Progress callback invoked from sherpa-onnx JNI via invoke(IIJ)Ljava/lang/Integer;
-keep class com.hex.stenographer.diarization.SherpaSpeakerDiarizer$ProgressCallback { *; }
